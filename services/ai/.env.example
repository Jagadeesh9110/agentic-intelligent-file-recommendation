# Python AI service configuration
APP_NAME=File Recommendation AI Service
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
AI_SERVICE_API_KEY=
MODEL_CACHE_DIR=
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_BATCH_SIZE=16
RERANKER_CANDIDATE_LIMIT=50
WORKFLOW_MAX_TOOL_CALLS=6
WORKFLOW_TIMEOUT_SECONDS=10
WORKFLOW_MAX_REFINEMENTS=1
AI_DATABASE_URL=postgresql+psycopg://postgres:replace-with-local-password@localhost:5434/agentic_files
